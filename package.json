    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.2"
  },
  "devDependencies": {
