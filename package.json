{
  "name": "arthurs-review",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:js && pnpm lint:ts",
    "lint:js": "oxlint",
    "lint:ts": "tsc --noEmit",
    "typecheck": "pnpm lint:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "scripts/run-e2e.sh",
    "jobs:work": "tsx scripts/jobs-worker.ts",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "backup:database": "tsx scripts/backup-database.ts",
    "proofs:backfill": "tsx scripts/backfill-publication-proofs.ts",
    "proof:replay": "tsx scripts/replay-proof.ts",
    "search:backfill": "tsx scripts/backfill-semantic-search.ts",
    "search:benchmark:index": "tsx scripts/index-semantic-benchmark.ts",
    "search:benchmark": "tsx scripts/run-semantic-benchmark.ts",
    "search:benchmark:stress": "tsx scripts/create-semantic-stress-corpus.ts",
    "seed": "tsx scripts/seed.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.13",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/ui": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
