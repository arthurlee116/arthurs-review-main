    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "7.1.0-dev.20260720.1",
    "vitest": "^4.1.10"
