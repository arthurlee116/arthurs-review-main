    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "next": "16.3.1-canary.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
