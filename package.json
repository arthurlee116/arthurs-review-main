    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost DATA_DIR=./data/e2e SITE_URL=http://127.0.0.1:3000 ADMIN_PASSWORD_HASH='scrypt$16384$8$1$YXJ0aHVycy1yZXZpZXctZTJl$B8w4AkTlSV2dCTJRqSbGGTODO+tbdf5CGiHMVKwR0JDtZTLg0Y2OufUAJ+wcBHuagSp1C/tvIpU/cD8/51AdGQ==' SESSION_SECRET=0123456789abcdefghijklmnopqrstuvwxyzABCDEF LOGIN_RATE_LIMIT_MAX=100 playwright test",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "proofs:backfill": "tsx scripts/backfill-publication-proofs.ts",
    "seed": "tsx scripts/seed.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
