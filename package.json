    "eslint": "^10.8.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "7.1.0-dev.20260720.1",
    "vitest": "^4.1.10"
