DATA_DIR=/data
SITE_URL=https://blog.leesaitool.com
# Build-time only: configure the GitHub repository variable of this name.
# Changing the running container environment does not change the built token.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$REPLACE_WITH_SALT$REPLACE_WITH_HASH
SESSION_SECRET=replace-with-32-plus-random-characters
WORKER_REVALIDATE_SECRET=replace-with-an-independent-32-plus-random-secret
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
WAYBACK_ACCESS_KEY=replace-with-internet-archive-access-key
WAYBACK_SECRET_KEY=replace-with-internet-archive-secret-key
OTS_CLI_PATH=/opt/opentimestamps/bin/ots
